			"tooltips": {
				"advancedmenu": "切换到高级建筑菜单，提供更多控制选项。\n\n<color=yellow>建议在对建筑系统更熟悉后再使用此功能！</color>",
				"basicmenu": "返回基本建筑菜单",
				"collisions": "切换此元素的碰撞。如果禁用，元素将放置在其中心点与你当前在世界中看向的位置。\n\n默认启用",
				"flip": "镜像/翻转元素。\n\n或者你也可以按<b>\"{0}\"</b>来翻转元素",
				"grid": "切换网格。如果网格启用，元素将始终吸附到固定网格。\n\n你可以使用<b>\"{0}\"</b>和<b>\"{1}\"</b>来更改网格大小。\n\n或者你也可以按<b>\"{2}\"</b>来切换网格",
				"loadpreset": "允许你加载之前保存的尺寸预设",
				"manualplacement": "切换手动放置。如果启用，元素不再跟随你的光标，而是锁定在当前位置。\n\n要移动锁定的元素，使用与旋转相同的按键。\n\n或者你也可以按<b>\"{0}\"</b>来切换手动放置",
				"modularsnapping": "切换模块化吸附。如果启用，元素将自动吸附到你当前看着的元素。\n\n绿色圆点(当看着一个元素时)将成为活动轴心，即旋转你的元素时，它将围绕此点旋转。\n\n或者你也可以按<b>\"{0}\"</b>来切换模块化吸附",
				"movemode": "决定手动移动模式(<b>{0}</b>)的工作方式。\n\n<align=left>\n<color=yellow>世界：</color>移动始终沿着固定的世界轴(默认)\n\n<color=yellow>本地：</color>移动沿着本地元素轴(即取决于元素旋转)\n</align>",
				"moveprecision": "决定手动移动模式(<b>{0}</b>)激活时的精度",
				"pivotmode": "决定模块化吸附(<b>{0}</b>)应如何工作。\n\n<align=left>\n<color=yellow>自动：</color>自动选择最近的轴心。推荐模式(默认)\n\n<color=yellow>手动：</color>你手动选择活动轴心(用按键<b>\"{1}\"</b>和<b>\"{2}\"</b>)\n</align>\n\n默认模式：自动(推荐)",
				"resetrotation": "重置元素的当前旋转\n\n或者按<b>\"{0}\"</b>重置旋转",
				"resetsize": "将尺寸重置为默认值<nobr>{0}</nobr>\n\n或者按<b>\"{1}\"</b>重置尺寸",
				"rotateprecision": "决定旋转元素时的精度",
				"rotationmode": "决定元素应如何旋转。\n\n<align=left>\n<color=yellow>默认：</color>世界和本地模式的混合(默认)\n\n<color=yellow>世界：</color>旋转始终围绕固定的世界轴，不受元素旋转影响\n\n<color=yellow>本地：</color>旋转始终围绕本地轴，基于元素的旋转\n</align>",
				"savepreset": "允许你将当前元素尺寸保存为预设，以便随时加载",
				"scaleprecision": "决定调整元素大小时的精度",
				"surfaceedit": "启用/禁用高级表面编辑模式。\n\n这允许你单独移动元素的上部",
				"texturealignment": "决定纹理的对齐方式，即是否应跟随元素旋转或具有固定的世界对齐方式",
				"texturescale": "决定纹理的大小。较低的值使纹理显得更大，较高的值使其显得更小。\n\n默认值为1"
			}
		},
