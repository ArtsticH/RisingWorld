						"page_resources": {
							"aluminium": "铝矿",
							"cloth": "布料",
							"coal": "煤矿",
							"gold": "金矿",
							"header": "HT资源一览表",
							"iron": "铁矿",
							"leather": "皮革",
							"paper": "草纸",
							"resources_aluminium": {
								"header": "铝矿",
								"image1": {
									"label": "铝矿石，有时会被积雪覆盖…"
								},
								"image2": {
									"label": "洞穴中的铝矿"
								},
"text1": "铝矿仅出现在<u>北极岛屿</u>上，即雪地区域！\n\n<b>从你的起始岛屿出发，向<u>北</u>旅行以找到北极岛屿！</b>",
								"text2": "它同时出现在地下和地表。请注意，地表矿石有时会被雪覆盖，因此很难发现。"
							},
							"resources_cloth": {
								"header": "布料",
								"image1": {
									"label": "从大麻植物上收集纤维"
								},
								"image2": {
									"label": "使用剪刀从羊身上获取羊毛"
								},
								"image3": {
									"label": "棉花出现在干旱岛屿上"
								},
								"image4": {
									"label": "将纤维/羊毛/棉花放在线轴上"
								},
								"text1": "布料需要纱线。\n\n为了获取纱线，你必须收集羊毛、大麻纤维或棉花。\n需要一个<u>纺车</u>来将其变成纱线。\n\n为此，将羊毛/棉花/纤维拿在手中，看着纺车的线轴 - 然后按住{SecondaryAction}将其纺成纱线。"
							},
							"resources_coal": {
								"header": "煤矿",
								"image1": {
									"label": "洞穴中的煤。有时很难发现……"
								},
								"text1": "煤仅出现在<u>地下</u>！最容易找到的方法是探索洞穴。",
								"text2": "煤主要用作燃料(例如用于熔炉、烤箱等)。\n\n但是，如果你在找煤方面有困难，请记住，通常你也可以用木头作为燃料 - 只是效率稍低一些。"
							},
							"resources_gold": {
								"header": "金矿",
								"image1": {
									"label": "洞穴中的金矿石矿脉"
								},
								"image2": {
									"label": "干旱岛屿上的地表金矿石"
								},
								"text1": "金矿仅出现在<u>干旱岛屿</u>上，即沙漠、草原等。\n\n<b>从你的起始岛屿出发，向<u>南</u>旅行以找到干旱岛屿！</b>",
								"text2": "为了前往另一个岛屿，你需要一艘船。建议建造一艘帆船，这样你能够快速旅行到其他岛屿。"
							},
							"resources_iron": {
								"header": "铁矿",
								"image1": {
									"label": "地表上的铁矿石"
								},
								"image2": {
									"label": "洞穴中的地下铁矿石矿脉"
								},
								"text1": "像煤一样，铁也出现在地下。矿石有微弱的闪光效果，这使得在黑暗的洞穴中更容易发现它们。\n\n然而，铁也生成在地表：留意铁矿石。",
								"text2": "铁可以在每个岛屿的任何地方找到！"
							},
							"resources_leather": {
								"header": "皮革",
								"image1": {
									"label": "通过解剖死亡动物获得兽皮/毛皮"
								},
								"image2": {
									"label": "将兽皮或毛皮放在鞣制架上，拿起刀并按住<b>鼠标右键</b>将其变成皮革"
								},
								"text1": "皮革由动物兽皮和毛皮制成。你需要一个<u>鞣制架</u>和一把<u>刀</u>将生皮变成皮革。\n\n将兽皮放在鞣制架上，装备一把刀并按住<b>鼠标左键</b>将其变成皮革。",
								"text2": "要从死亡动物身上获得毛皮或兽皮，使用一把刀 - 一把原始刀就足够了。"
							},
							"resources_paper": {
								"header": "草纸",
								"image1": {
									"label": "研磨机 + 布料 = 碎布条"
								},
								"image2": {
									"label": "造纸机将碎布条变成纸"
								},
								"text1": "纸由碎布条制成，需要<u>造纸机</u>。",
								"text2": "碎布条由布料制成：将布料放入研磨机中以将其变成碎布条。\n然后你可以将碎布条放入造纸机中将其变成纸。"
							},
							"resources_sand": {
								"header": "砂岩",
								"image1": {
									"label": "温带区域的沙滩。然而，这很罕见，所以通常更容易旅行到干旱岛屿。"
								},
								"text1": "沙偶尔可以在海滩上找到。然而，沙滩很罕见，所以通常更有意义的是旅行到干旱岛屿。\n\n在那里你会发现大量的沙(例如在沙漠、草原等)。",
								"text2": "沙主要用于生产<u>玻璃</u>。将沙放入熔炉中熔炼成原始玻璃。"
							},
							"resources_stone": {
								"header": "石材",
								"image1": {
									"label": "你可以从地上捡起小石头"
								},
								"image2": {
									"label": "记住：一切都是可破坏的。只需在地上挖一个洞来获取石头"
								},
								"text1": "获取石头非常简单：只需挖掘地面直到你碰到石头。\n\n当挖掘石头时，它会自动添加到你的物品栏中，所以你不需要捡起它。",
								"text2": "或者你也可以从地上捡起小石头！"
							},
							"resources_sulfur": {
								"header": "硫磺矿",
								"image1": {
									"label": "硫磺矿脉"
								},
								"image2": {
									"label": "世界底部充满水的深层洞穴"
								},
								"text1": "硫磺看起来有点像金，但表面更粗糙，并且不闪亮。",
								"text2": "目前它仅在最深的洞穴中找到 - 那些充满水的洞穴。\n\n<b>在那里要小心……有传言说水洞正下方有一个可怕的地方！</b>"
							},
							"resources_tungsten": {
								"header": "钨矿",
								"image1": {
									"label": "洞穴中的钨矿石"
								},
								"text1": "钨可以在每个岛屿上找到，但仅在地下 - 主要在更深的洞穴中。\n\n它有暗色，所以可以与其他矿石区分开。",
								"text2": "钨主要用于先进的电子组件。确保在下降进入深层洞穴时装备良好。"
							},
							"resources_wood": {
								"header": "木材",
								"image1": {
									"label": "用你的斧头砍倒树木"
								},
								"image2": {
									"label": "将原木砍成小块，然后可以捡起"
								},
								"image3": {
									"label": "你可以随机在地上找到树枝"
								},
								"image4": {
									"label": "你也可以从枯死的灌木丛中获得树枝/木棍"
								},
								"text1": "你可以通过砍伐树木来获取木材。\n\n\n你也可以直接从地上的树枝或枯死的灌木丛(主要出现在森林中)获取木棍。\n\n\n打开你的<b>制作菜单</b>将原木变成<u>木材</u>或<u>木棍</u>。"
							},
							"sand": "砂岩",
							"stone": "石材",
							"sulfur": "硫磺矿",
							"tungsten": "钨矿",
							"wood": "木材"
						},
						"page_servernotes": {
							"header": "服务器日志公告"
						}
					}
				}
			}
		},
